# Copy to .env and adjust. Every value here is optional; the defaults serve
# Metro Transit in the Twin Cities.

# --- Server ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=warn

# Serve the built web client from the API server (production single-process).
# SERVE_STATIC=1

# --- Demo mode ---
# Serve a synthetic feed instead of fetching real data. No network is used.
# LIVETRAINS_MOCK=1

# --- Feeds ---
REALTIME_POLL_SECONDS=15
GTFS_MAX_AGE_HOURS=24

# --- Trip planner ---
PLANNER_MAX_WALK_METERS=1200
PLANNER_WALK_SPEED=1.33
PLANNER_MAX_TRANSFERS=3

# --- Which agency to serve ---
AGENCY_ID=metro-transit

# --- Or define an agency from scratch (any city publishing GTFS) ---
# AGENCY_ID=trimet
# AGENCY_NAME=TriMet (Portland)
# AGENCY_TIMEZONE=America/Los_Angeles
# AGENCY_GTFS_URL=https://developer.trimet.org/schedule/gtfs.zip
# AGENCY_RT_VEHICLES=https://developer.trimet.org/ws/gtfs/VehiclePositions
# AGENCY_RT_TRIP_UPDATES=https://developer.trimet.org/ws/gtfs/TripUpdates
# AGENCY_RT_ALERTS=
# AGENCY_BBOX=-123.2,45.2,-122.2,45.7
# AGENCY_CENTER=-122.68,45.52
# AGENCY_ATTRIBUTION=Schedule and realtime data (c) TriMet

# --- Optional address search ---
# Local stop and landmark search always works. Setting this adds free-text
# address lookup; review the provider's usage policy before enabling it.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
